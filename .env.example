# Copy to .env.local for local development. Never commit .env.local.
# On Vercel set every variable in Project → Settings → Environment Variables, then REDEPLOY
# (NEXT_PUBLIC_* values are baked in at build time).

# --- Firebase web app (public, from Firebase console → Project settings → Your apps) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# true = browser talks to the local emulators (auth 9099, firestore 8080). Never true on Vercel.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# --- Server only (cron route) ---
# base64 of the service-account JSON key (see README, "Service account")
FIREBASE_SERVICE_ACCOUNT_JSON=
# Long random string. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Public URL of the portal, used for links in emails
APP_BASE_URL=http://localhost:3000

# --- Email ---
# graph (default, Microsoft Graph app-only) | smtp (fallback)
MAIL_TRANSPORT=graph
# Shared mailbox the digests are sent from
MAIL_FROM=hr-alerts@example.com
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# SMTP fallback (only when MAIL_TRANSPORT=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- scripts/seed-admin.ts (local only) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Portal Admin
